<%- include("../partials/header", { title: dish.name }) %>

<a class="back" href="/dishes">← Thực đơn</a>

<div class="card detail">
  <h1><%= dish.name %></h1>
  <p class="price"><%= dish.price.toLocaleString("vi-VN") %>đ</p>

  <dl>
    <dt>Loại</dt>
    <dd><% if (dish.category) { %><span class="chip"><%= dish.category %></span><% } else { %>—<% } %></dd>

    <dt>Tình trạng</dt>
    <dd>
      <% if (dish.available) { %><span class="badge on">Đang phục vụ</span>
      <% } else { %><span class="badge off">Tạm hết</span><% } %>
    </dd>

    <dt>Mô tả</dt>
    <dd><%= dish.description ?? "—" %></dd>
  </dl>
</div>

<%- include("../partials/footer") %>
