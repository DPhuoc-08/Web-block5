<%- include("../../partials/header", { title: "Quản trị nguyên liệu", section: "admin" }) %>
<%- include("../../partials/admin-nav", { current: "ingredients" }) %>

<div class="toolbar">
  <h1>Nguyên liệu</h1>
  <a class="btn btn-primary" href="/admin/ingredients/new">+ Thêm nguyên liệu</a>
</div>

<%- include("../../partials/admin-search", { action: "/admin/ingredients", q, count: ingredients.length, label: "Tìm nguyên liệu", placeholder: "Tìm theo tên hoặc đơn vị" }) %>

<% if (ingredients.length === 0) { %>
  <div class="panel empty"><%= q ? "Không có nguyên liệu nào khớp từ khoá." : "Chưa có nguyên liệu nào." %></div>
<% } else { %>
  <div class="panel table-wrap">
    <table>
      <thead>
        <tr><th>#</th><th>Tên</th><th>Đơn vị</th><th><span class="sr-only">Thao tác</span></th></tr>
      </thead>
      <tbody>
        <% ingredients.forEach(i => { %>
          <tr>
            <td class="num"><%= i.id %></td>
            <td><%= i.name %></td>
            <td><%= i.unit ?? "—" %></td>
            <td class="actions">
              <a class="btn btn-sm" href="/admin/ingredients/<%= i.id %>/edit">Sửa</a>
              <a class="btn btn-sm danger-text" href="/admin/ingredients/<%= i.id %>/delete">Xoá</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include("../../partials/footer", { section: "admin" }) %>
