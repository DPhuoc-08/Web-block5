<%- include("../../partials/header", { title: "Quản trị nguyên liệu" }) %>
<%- include("../../partials/admin-nav", { current: "ingredients" }) %>

<div class="toolbar">
  <h1>Nguyên liệu</h1>
  <a href="/admin/ingredients/new">+ Thêm nguyên liệu</a>
</div>

<% if (ingredients.length === 0) { %>
  <p class="muted">Chưa có nguyên liệu nào.</p>
<% } else { %>
  <table>
    <thead>
      <tr><th>#</th><th>Tên</th><th>Đơn vị</th><th></th></tr>
    </thead>
    <tbody>
      <% ingredients.forEach(i => { %>
        <tr>
          <td><%= i.id %></td>
          <td><%= i.name %></td>
          <td><%= i.unit ?? "—" %></td>
          <td class="actions">
            <a href="/admin/ingredients/<%= i.id %>/edit">Sửa</a>
            <a href="/admin/ingredients/<%= i.id %>/delete">Xoá</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include("../../partials/footer") %>
