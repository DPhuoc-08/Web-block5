<% const isEdit = id !== null; -%>
<%- include("../../partials/header", { title: isEdit ? "Sửa đầu bếp" : "Thêm đầu bếp" }) %>

<a class="back" href="/admin/chefs">← Danh sách đầu bếp</a>

<div class="card form-card">
  <h1><%= isEdit ? "Sửa đầu bếp" : "Thêm đầu bếp" %></h1>

  <% if (Object.keys(errors).length) { %>
    <p class="alert">Dữ liệu chưa hợp lệ, vui lòng sửa các trường bên dưới.</p>
  <% } %>

  <form class="form" method="POST" action="<%= isEdit ? `/admin/chefs/${id}?_method=PATCH` : "/admin/chefs" %>">
    <label class="field <%= errors.name ? "invalid" : "" %>">
      <span>Tên đầu bếp</span>
      <input name="name" value="<%= values.name %>">
      <% if (errors.name) { %><span class="error"><%= errors.name %></span><% } %>
    </label>

    <label class="field">
      <span>Chuyên môn</span>
      <input name="specialty" value="<%= values.specialty %>" placeholder="Món nướng, Tráng miệng...">
    </label>

    <div class="form-actions">
      <button class="btn btn-primary"><%= isEdit ? "Lưu" : "Thêm" %></button>
      <a class="btn" href="/admin/chefs">Huỷ</a>
    </div>
  </form>
</div>

<%- include("../../partials/footer") %>
