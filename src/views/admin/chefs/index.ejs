<%- include("../../partials/header", { title: "Quản trị đầu bếp", section: "admin" }) %>
<%- include("../../partials/admin-nav", { current: "chefs" }) %>

<div class="toolbar">
  <h1>Đầu bếp</h1>
  <a class="btn btn-primary" href="/admin/chefs/new">+ Thêm đầu bếp</a>
</div>

<%- include("../../partials/admin-search", { action: "/admin/chefs", q, count: chefs.length, label: "Tìm đầu bếp", placeholder: "Tìm theo tên hoặc chuyên môn" }) %>

<% if (chefs.length === 0) { %>
  <div class="panel empty"><%= q ? "Không có đầu bếp nào khớp từ khoá." : "Chưa có đầu bếp nào." %></div>
<% } else { %>
  <div class="panel table-wrap">
    <table>
      <thead>
        <tr><th>#</th><th>Tên</th><th>Chuyên môn</th><th>Phụ trách</th><th><span class="sr-only">Thao tác</span></th></tr>
      </thead>
      <tbody>
        <% chefs.forEach(c => { %>
          <tr>
            <td class="num" data-label="Mã"><%= c.id %></td>
            <td class="title" data-label="Tên"><%= c.name %></td>
            <td data-label="Chuyên môn"><%= c.specialty ?? "—" %></td>
            <td data-label="Phụ trách"><%= c._count.dishes %> món</td>
            <td class="actions">
              <a class="btn btn-sm" href="/admin/chefs/<%= c.id %>/edit">Sửa</a>
              <a class="btn btn-sm danger-text" href="/admin/chefs/<%= c.id %>/delete">Xoá</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include("../../partials/footer", { section: "admin" }) %>
