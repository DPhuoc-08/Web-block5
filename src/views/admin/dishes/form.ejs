<% const isEdit = id !== null; -%>
<%- include("../../partials/header", { title: isEdit ? "Sửa món" : "Thêm món", section: "admin" }) %>

<a class="back" href="/admin/dishes">← Danh sách món</a>

<div class="panel form-panel">
  <h1><%= isEdit ? "Sửa món" : "Thêm món" %></h1>
  <% if (isEdit) { %><p class="muted" style="margin: 0">Món #<%= id %></p><% } %>

  <% if (Object.keys(errors).length) { %>
    <p class="alert">Dữ liệu chưa hợp lệ, vui lòng sửa các trường bên dưới.</p>
  <% } %>

  <%# Thêm: POST /admin/dishes. Sửa: vẫn POST nhưng kèm ?_method=PATCH để method-override đổi thành PATCH.
      Không đặt required/min trên input: kiểm tra dữ liệu do server làm (trả 400 nếu sai). %>
  <form class="form" method="POST" action="<%= isEdit ? `/admin/dishes/${id}?_method=PATCH` : "/admin/dishes" %>">
    <label class="field <%= errors.name ? "invalid" : "" %>">
      <span>Tên món</span>
      <input name="name" value="<%= values.name %>">
      <% if (errors.name) { %><span class="error"><%= errors.name %></span><% } %>
    </label>

    <label class="field <%= errors.price ? "invalid" : "" %>">
      <span>Giá (đồng)</span>
      <input name="price" type="number" value="<%= values.price %>" placeholder="50000">
      <% if (errors.price) { %><span class="error"><%= errors.price %></span><% } %>
    </label>

    <label class="field <%= errors.category ? "invalid" : "" %>">
      <span>Loại</span>
      <select name="category">
        <option value="">— Chọn loại món —</option>
        <% categories.forEach(c => { %>
          <option value="<%= c %>" <%= values.category === c ? "selected" : "" %>><%= c %></option>
        <% }) %>
      </select>
      <% if (errors.category) { %><span class="error"><%= errors.category %></span><% } %>
    </label>

    <label class="field">
      <span>Mô tả</span>
      <textarea name="description" rows="3"><%= values.description %></textarea>
    </label>

    <%# Đầu bếp phụ trách: chọn đúng 1 (radio). Giá trị gửi lên là id; server kiểm tra id có thật trong DB. %>
    <fieldset class="choice-group <%= errors.chefId ? "invalid" : "" %>">
      <legend>Đầu bếp phụ trách</legend>
      <% if (errors.chefId) { %><p class="error"><%= errors.chefId %></p><% } %>
      <% if (chefs.length === 0) { %>
        <p class="muted">Chưa có đầu bếp nào. <a href="/admin/chefs/new">Thêm đầu bếp</a> trước khi tạo món.</p>
      <% } %>
      <div class="choice-grid">
        <% chefs.forEach(c => { %>
          <label class="choice">
            <input type="radio" name="chefId" value="<%= c.id %>" <%= values.chefId === String(c.id) ? "checked" : "" %>>
            <span><strong><%= c.name %></strong><% if (c.specialty) { %><small><%= c.specialty %></small><% } %></span>
          </label>
        <% }) %>
      </div>
    </fieldset>

    <%# Nguyên liệu: tick nhiều ô, cùng name="ingredientIds" → server nhận mảng id (lưu vào bảng dish_ingredients). %>
    <fieldset class="choice-group <%= errors.ingredientIds ? "invalid" : "" %>">
      <legend>Nguyên liệu <small class="muted">(chọn ít nhất 1)</small></legend>
      <% if (errors.ingredientIds) { %><p class="error"><%= errors.ingredientIds %></p><% } %>
      <% if (ingredients.length === 0) { %>
        <p class="muted">Chưa có nguyên liệu nào. <a href="/admin/ingredients/new">Thêm nguyên liệu</a> trước khi tạo món.</p>
      <% } %>
      <div class="choice-grid compact">
        <% ingredients.forEach(i => { %>
          <label class="choice">
            <input type="checkbox" name="ingredientIds" value="<%= i.id %>" <%= values.ingredientIds.includes(i.id) ? "checked" : "" %>>
            <span><%= i.name %><% if (i.unit) { %> <small><%= i.unit %></small><% } %></span>
          </label>
        <% }) %>
      </div>
    </fieldset>

    <label class="field <%= errors.imageUrl ? "invalid" : "" %>">
      <span>Link ảnh minh hoạ</span>
      <input name="imageUrl" value="<%= values.imageUrl %>" placeholder="https://upload.wikimedia.org/...">
      <span class="hint">Dán link trực tiếp tới file ảnh (nên dùng ảnh có giấy phép mở, vd. Wikimedia Commons).</span>
      <% if (errors.imageUrl) { %><span class="error"><%= errors.imageUrl %></span><% } %>
    </label>
    <% if (values.imageUrl && !errors.imageUrl) { %>
      <img class="image-preview" src="<%= values.imageUrl %>" alt="Ảnh hiện tại của món" referrerpolicy="no-referrer">
    <% } %>

    <label class="field <%= errors.imageCredit ? "invalid" : "" %>">
      <span>Ghi công ảnh</span>
      <input name="imageCredit" value="<%= values.imageCredit %>" placeholder="Tác giả · Giấy phép · Nguồn">
      <% if (errors.imageCredit) { %><span class="error"><%= errors.imageCredit %></span><% } %>
    </label>

    <label class="field inline">
      <input name="available" type="checkbox" <%= values.available ? "checked" : "" %>>
      <span>Đang phục vụ</span>
    </label>

    <div class="form-actions">
      <button class="btn btn-primary"><%= isEdit ? "Lưu" : "Thêm" %></button>
      <a class="btn" href="/admin/dishes">Huỷ</a>
    </div>
  </form>
</div>

<%- include("../../partials/footer", { section: "admin" }) %>
