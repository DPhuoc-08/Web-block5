<%- include("../../partials/header", { title: "Quản trị món ăn", section: "admin" }) %>
<%- include("../../partials/admin-nav", { current: "dishes" }) %>

<div class="toolbar">
  <h1>Món ăn</h1>
  <a class="btn btn-primary" href="/admin/dishes/new">+ Thêm món</a>
</div>

<%- include("../../partials/admin-search", { action: "/admin/dishes", q, count: dishes.length, label: "Tìm món", placeholder: "Tìm theo tên hoặc loại món" }) %>

<% if (dishes.length === 0) { %>
  <div class="panel empty"><%= q ? "Không có món nào khớp từ khoá." : "Chưa có món nào." %></div>
<% } else { %>
  <div class="panel table-wrap">
    <table>
      <thead>
        <tr><th>#</th><th>Ảnh</th><th>Tên</th><th>Giá</th><th>Loại</th><th>Tình trạng</th><th><span class="sr-only">Thao tác</span></th></tr>
      </thead>
      <tbody>
        <% dishes.forEach(d => { %>
          <tr>
            <%# data-label: nhãn cột hiện trên điện thoại khi bảng chuyển thành thẻ (xem style.css). %>
            <td class="num" data-label="Mã"><%= d.id %></td>
            <td class="thumb" data-label="Ảnh"><% if (d.imageUrl) { %><img class="table-thumb" src="<%= d.imageUrl %>" alt="" loading="lazy" referrerpolicy="no-referrer"><% } else { %><span class="muted">—</span><% } %></td>
            <td class="title" data-label="Tên"><a href="/dishes/<%= d.id %>"><%= d.name %></a></td>
            <td data-label="Giá"><%= d.price.toLocaleString("vi-VN") %>đ</td>
            <td data-label="Loại"><%= d.category ?? "—" %></td>
            <td data-label="Tình trạng"><span class="badge <%= d.available ? "on" : "off" %>"><%= d.available ? "Đang phục vụ" : "Tạm hết" %></span></td>
            <%# Hai link GET chỉ mở trang (form sửa, trang xác nhận xoá); việc ghi diễn ra ở form trên các trang đó. %>
            <td class="actions">
              <a class="btn btn-sm" href="/admin/dishes/<%= d.id %>/edit">Sửa</a>
              <a class="btn btn-sm danger-text" href="/admin/dishes/<%= d.id %>/delete">Xoá</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include("../../partials/footer", { section: "admin" }) %>
