<%- include("../../partials/header", { title: "Xoá món", section: "admin" }) %>

<a class="back" href="/admin/dishes">← Danh sách món</a>

<div class="panel confirm">
  <h1>Xoá món “<%= dish.name %>”?</h1>
  <p class="muted">Món sẽ bị xoá khỏi thực đơn và không khôi phục được.</p>

  <%# Xoá chỉ xảy ra khi bấm nút này: POST kèm ?_method=DELETE (method-override đổi thành DELETE). %>
  <form class="form-actions" method="POST">
    <button class="btn btn-danger" formaction="/admin/dishes/<%= dish.id %>?_method=DELETE">Xoá</button>
    <a class="btn" href="/admin/dishes">Huỷ</a>
  </form>
</div>

<%- include("../../partials/footer", { section: "admin" }) %>
