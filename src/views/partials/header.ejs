<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Nhà hàng</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 760px; margin: 0 auto; padding: 0 16px 48px; line-height: 1.5; color: #222; }
    header { display: flex; gap: 16px; align-items: baseline; border-bottom: 1px solid #ddd; padding: 12px 0; margin-bottom: 24px; }
    header .brand { font-weight: 700; font-size: 1.15rem; margin-right: auto; }
    a { color: #b4451f; }
    ul.list { padding-left: 20px; }
    ul.list li { margin: 6px 0; }
    .muted { color: #777; }
    .badge { font-size: .8rem; padding: 1px 8px; border-radius: 10px; background: #eee; }
    .badge.off { background: #f6d5d5; color: #8a1f1f; }
    form.search { display: flex; gap: 8px; margin-bottom: 16px; }
    input, textarea, select { font: inherit; padding: 6px 8px; }
    button { font: inherit; padding: 6px 14px; cursor: pointer; }
    dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; }
    dt { font-weight: 600; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #eee; }
    td.actions { white-space: nowrap; }
    td.actions a { margin-right: 8px; }
    .toolbar { display: flex; justify-content: space-between; align-items: center; }
    form.stack { display: grid; gap: 14px; max-width: 480px; }
    form.stack label { display: grid; gap: 4px; font-weight: 600; }
    form.stack label.inline { display: flex; gap: 8px; align-items: center; }
    .error { color: #b00020; font-weight: 400; font-size: .9rem; }
    .alert { background: #fdecea; border: 1px solid #f5c2c0; padding: 8px 12px; border-radius: 6px; }
    .danger { background: #b00020; color: #fff; border: 0; border-radius: 4px; }
  </style>
</head>
<body>
  <header>
    <span class="brand">Nhà hàng</span>
    <a href="/dishes">Thực đơn</a>
    <a href="/admin/dishes">Quản trị</a>
  </header>
  <main>
